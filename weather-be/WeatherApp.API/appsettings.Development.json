{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=weatherapp;Username=weatherapp;Password=weatherapp"
  },
  "Auth": {
    "Issuer": "weather-api",
    "Audience": "weather-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SecureCookie": false,
    "Key": "[USER SECRET]"
  },
  "WeatherServiceConfiguration": {
    "BaseUrl": "https://api.openweathermap.org",
    "ApiKey": "[USER SECRET]"
  }
}
