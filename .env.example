# Copy to .env and fill in.  .env is gitignored; this file is not.

# --- OpenWeather (https://openweathermap.org/api) -------------------------
# A new key takes up to ~2h to activate.
OPENWEATHER_API_KEY=

# --- JWT ------------------------------------------------------------------
# Must be >= 32 bytes for HS256. Generate one with:
#   openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=weather-api
JWT_AUDIENCE=weather-web
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=weatherapp
POSTGRES_PASSWORD=
POSTGRES_DB=weatherapp

# --- Host ports -----------------------------------------------------------
WEB_PORT=5173
API_PORT=8080
DB_PORT=5432
PGADMIN_PORT=5050

# --- pgAdmin (dev only, from docker-compose.override.yml) -----------------
# Runs in desktop mode (no login). These only matter if you flip SERVER_MODE on.
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# Set to Production to run the built images without dev tooling
ASPNETCORE_ENVIRONMENT=Development
